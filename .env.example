# Postgres connection string. On Vercel, the Neon integration sets this for you.
# Locally, use a Neon dev branch or a local Postgres.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Encrypts client LeadShark API keys at rest. Any long random string; keep it stable,
# because changing it makes saved keys unreadable. Generate one with: openssl rand -base64 32
ENCRYPTION_KEY=

# Vercel sends this as a Bearer token when it runs the weekly cron. Generate like ENCRYPTION_KEY.
CRON_SECRET=

# Timezone that decides where a week starts and which weekday a post lands on.
REPORT_TIMEZONE=Europe/London

# Optional: shown in the app header and the PDF footer ("Prepared by ...").
AGENCY_NAME=

# Optional: override the LeadShark API host (useful for testing against a mock).
# LEADSHARK_API_URL=https://apex.leadshark.io
